<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="outdoor_small_world">

    <!-- Cheap rendering settings so this stays light on low-end GPUs -->
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.6 0.8 1.0 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Grass-colored ground plane, 10x10m -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.15 0.5 0.15 1</ambient>
            <diffuse>0.2 0.6 0.2 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- A few simple trees: cylinder trunk + sphere canopy, cheap primitives -->
    <model name="tree_1">
      <static>true</static>
      <pose>3 3 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy_visual">
          <pose>0 0 1.3 0 0 0</pose>
          <geometry><sphere><radius>0.6</radius></sphere></geometry>
          <material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_2">
      <static>true</static>
      <pose>-3 3 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy_visual">
          <pose>0 0 1.3 0 0 0</pose>
          <geometry><sphere><radius>0.6</radius></sphere></geometry>
          <material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_3">
      <static>true</static>
      <pose>-3 -3 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy_visual">
          <pose>0 0 1.3 0 0 0</pose>
          <geometry><sphere><radius>0.6</radius></sphere></geometry>
          <material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_4">
      <static>true</static>
      <pose>3 -3 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="canopy_visual">
          <pose>0 0 1.3 0 0 0</pose>
          <geometry><sphere><radius>0.6</radius></sphere></geometry>
          <material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A couple of simple rock obstacles (plain boxes, cheap) -->
    <model name="rock_1">
      <static>true</static>
      <pose>1.5 0 0.15 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.3</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>-1.5 -1 0.12 0 0 1.1</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.25 0.25</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.25 0.25</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Small pickable object, positioned within the UR arm's reach for a
         pick-and-place demo (see try_pose.sh tuning: gripper reaches
         x~0.0, y~0.39, z~0.14 relative to base_footprint when the robot
         spawns at the origin). -->
    <model name="pickup_object">
      <pose>0.0 0.39 0.09 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.00003</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.035</radius><length>0.18</length></cylinder></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.035</radius><length>0.18</length></cylinder></geometry>
          <material><ambient>0.8 0.05 0.05 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
